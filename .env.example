TAG=latest
DATABASE_URL=mysql://root:@host.docker.internal:3306/clinic
# Để chạy nhiều domain, dùng database registry riêng và khai báo tenant bên dưới.
# MANAGEMENT_DATABASE_URL=mysql://root:@host.docker.internal:3306/clinic_registry
# TENANTS_JSON=[{"domain":"clinic-a.example.com","databaseUrl":"mysql://user:password@host.docker.internal:3306/clinic_a"},{"domain":"clinic-b.example.com","databaseUrl":"mysql://user:password@host.docker.internal:3306/clinic_b"}]
# TYPEORM_SYNCHRONIZE=false
MANAGEMENT_DATABASE_URL=
PLATFORM_ADMIN_EMAIL=superadmin@vienvu.com
PLATFORM_ADMIN_PASSWORD=dhusagfydastfydsayfdtyasfd2314321432
PLATFORM_ADMIN_NAME=Super Admin
PLATFORM_JWT_SECRET=
PLATFORM_ADMIN_PORT=9996
TENANT_DOMAIN_CACHE_TTL_MS=300000
TENANTS_JSON=
TYPEORM_SYNCHRONIZE=true
JWT_SECRET=development-only-secret
JWT_EXPIRES_IN=30d
ADMIN_EMAIL=admin@thienchanh.local
ADMIN_PASSWORD=Admin@123
# Public URL used by browsers to reach the API on port 9998.
PUBLIC_API_URL=http://127.0.0.1:9998/api
LANDING_PUBLIC_URL=http://127.0.0.1:9997
LANDING_PORT=9997
API_PORT=9998
ADMIN_PORT=9999
LANDING_REVALIDATE_SECRET=replace-with-a-long-random-secret
# Google Drive dùng chung theo từng tenant/công ty. Callback URI phải khai báo giống hệt trên Google Cloud.

# Khuyến nghị đặt một secret riêng, dài, chỉ dùng để mã hóa refresh token tại DB.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
UPLOADS_DIR=./data/uploads
# Error 500 logs are stored as JSON Lines files, one file per UTC day.
LOGS_DIR=./data/logs
ERROR_LOG_ENABLED=true
