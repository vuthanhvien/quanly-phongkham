TAG=latest
DATABASE_URL=mysql://root:@host.docker.internal:3306/clinic
# Để chạy nhiều domain, dùng database registry riêng và khai báo tenant bên dưới.
# MANAGEMENT_DATABASE_URL=mysql://root:@host.docker.internal:3306/clinic_registry
# TENANTS_JSON=[{"domain":"clinic-a.example.com","databaseUrl":"mysql://user:password@host.docker.internal:3306/clinic_a"},{"domain":"clinic-b.example.com","databaseUrl":"mysql://user:password@host.docker.internal:3306/clinic_b"}]
# TYPEORM_SYNCHRONIZE=false
MANAGEMENT_DATABASE_URL=
TENANTS_JSON=
TYPEORM_SYNCHRONIZE=true
JWT_SECRET=development-only-secret
ADMIN_EMAIL=admin@thienchanh.local
ADMIN_PASSWORD=Admin@123
LANDING_API_URL=http://127.0.0.1:3001/api
LANDING_REVALIDATE_URL=http://127.0.0.1:3002/api/revalidate
LANDING_REVALIDATE_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_API_URL=/api
VITE_API_URL=/api
VITE_BASE_PATH=/admin/
APP_PORT=9999
UPLOADS_DIR=./data/uploads
# Error 500 logs are stored as JSON Lines files, one file per UTC day.
LOGS_DIR=./data/logs
ERROR_LOG_ENABLED=true
