 # Google Drive dùng chung theo từng tenant/công ty. Callback URI phải khai báo giống hệt trên Google Cloud.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://api-clinic.giserp.vn/api/settings/google-drive/callback
